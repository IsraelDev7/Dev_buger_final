# ============================================================
# DevBurger API — variaveis de ambiente
# Copie para `.env` (bloqueado no .gitignore) e preencha.
# ============================================================

# ── Banco ──────────────────────────────────────────────────
# SQLite serve para desenvolvimento. Para qualquer coisa publicada,
# aponte para um Postgres e ajuste o provider no schema.prisma.
DATABASE_URL="file:./devburguer.db"

# ── Sessao ─────────────────────────────────────────────────
# Segredo que assina o JWT. Trocar este valor invalida todas as
# sessoes ativas — o que e exatamente o que se quer apos um incidente.
# Gere com: openssl rand -hex 32
JWT_SECRET=

# ── Pagamento (Stripe) ─────────────────────────────────────
# A chave secreta NUNCA vai para o frontend: o frontend usa a
# publicavel, e so o servidor conhece esta.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Administrador ──────────────────────────────────────────
# Usadas apenas por `npm run criar-admin`. NAO ha valor de reserva:
# sem estas, o script recusa rodar. Antes eram `admin@admin.com` e
# `admin123` fixos no codigo — ou seja, publicadas.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── Servidor ───────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
